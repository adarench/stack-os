# Database (Neon serverless Postgres)
# DATABASE_URL is the pooled connection (use for app runtime).
# DATABASE_URL_UNPOOLED is the direct connection (use for migrations + RLS tests).
# Neon dashboard → Connection details → "Pooled" + "Direct".
# Save these values in /web/.env.local (gitignored).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# Clerk auth (staff). Use a PRODUCTION instance (pk_live_/sk_live_) in prod.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
CLERK_SECRET_KEY="sk_test_replace_me"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# Single-org pin. We run one customer org today, so the app does not use Clerk
# Organizations at runtime — every authenticated user is scoped to this org.
# (Removes the /select-org dead-end.) Drop this when going multi-tenant.
STACK_ORG_ID="org_replace_me"
# Operator access gate (comma-separated emails). With the org pinned, only
# allow-listed accounts get operator access. Leave empty to disable the gate
# (dev only) — MUST be set in prod, or restrict sign-ups to invitations in Clerk.
ALLOWED_OPERATOR_EMAILS=""

# Vendor magic-link auth (separate from Clerk)
VENDOR_MAGIC_LINK_SECRET="replace_me_32_byte_hex"

# Storage (Cloudflare R2 or AWS S3)
# For R2: Cloudflare Dashboard → R2 → Manage R2 API Tokens → "Create API
# Token" → Object Read & Write, scope to bucket. The result page shows three
# values; the Access Key ID and Secret Access Key (NOT the cfat_ token) go
# into the S3_ vars below — the S3 SDK speaks S3 protocol, not Cloudflare's
# REST API.
S3_ENDPOINT="https://your-account.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="stack-os"
S3_ACCESS_KEY_ID="replace_me"
S3_SECRET_ACCESS_KEY="replace_me"

# Optional Cloudflare Account API token — kept for future bucket-management
# flows that hit Cloudflare's REST API directly. Not used by the S3 SDK.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Background jobs
INNGEST_EVENT_KEY="replace_me"
INNGEST_SIGNING_KEY="replace_me"

# Email (Resend)
# `onboarding@resend.dev` works without domain verification for testing.
# For production, verify a sending domain in the Resend dashboard.
RESEND_API_KEY="re_replace_me"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# SMS (Twilio) — A2P 10DLC registration required (2-4 wk lead time, file P0 day 1)
TWILIO_ACCOUNT_SID="ACreplace_me"
TWILIO_AUTH_TOKEN="replace_me"
TWILIO_FROM_NUMBER="+15555555555"

# Web push (VAPID). Generate once: `npx web-push generate-vapid-keys`.
# The public key must be identical in both vars (server signs, client subscribes).
# If unset, push is a no-op stub (email/in-app still send).
VAPID_PUBLIC_KEY="replace_me_vapid_public"
VAPID_PRIVATE_KEY="replace_me_vapid_private"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="replace_me_vapid_public"
VAPID_SUBJECT="mailto:ops@example.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_ENV="development"
