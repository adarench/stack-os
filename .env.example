# Database (Neon serverless Postgres)
# DATABASE_URL is the pooled connection (use for app runtime).
# DATABASE_URL_UNPOOLED is the direct connection (use for migrations + RLS tests).
# Neon dashboard → Connection details → "Pooled" + "Direct".
# Save these values in /web/.env.local (gitignored).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# Clerk auth (staff)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
CLERK_SECRET_KEY="sk_test_replace_me"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# Vendor magic-link auth (separate from Clerk)
VENDOR_MAGIC_LINK_SECRET="replace_me_32_byte_hex"

# Storage (Cloudflare R2 or AWS S3)
S3_ENDPOINT="https://your-account.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="stack-os-uploads"
S3_ACCESS_KEY_ID="replace_me"
S3_SECRET_ACCESS_KEY="replace_me"
S3_PUBLIC_BASE_URL="https://uploads.example.com"

# Background jobs
INNGEST_EVENT_KEY="replace_me"
INNGEST_SIGNING_KEY="replace_me"

# Email (Resend)
RESEND_API_KEY="re_replace_me"
RESEND_FROM_EMAIL="ops@example.com"

# SMS (Twilio) — A2P 10DLC registration required (2-4 wk lead time, file P0 day 1)
TWILIO_ACCOUNT_SID="ACreplace_me"
TWILIO_AUTH_TOKEN="replace_me"
TWILIO_FROM_NUMBER="+15555555555"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_ENV="development"
